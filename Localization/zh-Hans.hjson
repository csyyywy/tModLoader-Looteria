Mods: {
	Looteria: {
		Configs: {
			EnemyAffixConfig: {
				DisplayName: 敌人词缀配置

				Enable: {
					Label: 启用敌人词缀
					Tooltip: 敌人词缀系统总开关。关闭后敌人不再附加任何词缀。
				}

				CommonAffixChance: {
					Label: 普通怪词缀概率
					Tooltip: 普通非 Boss 怪带 1 条普通词缀的概率（0~50%，默认 20%）。
				}

				EliteChance: {
					Label: 精英率
					Tooltip: 非 Boss 敌人成为精英怪的概率（0~50%，默认 8%）。精英怪带 2~3 条词缀、效果更强、掉落更高。
				}

				EliteAffixCountMin: {
					Label: 精英词缀条数下限
					Tooltip: 精英怪至少带几条词缀（默认 2）。
				}

				EliteAffixCountMax: {
					Label: 精英词缀条数上限
					Tooltip: 精英怪最多带几条词缀（默认 3）。
				}

				BossAffixCountMin: {
					Label: Boss 普通词缀下限
					Tooltip: Boss 至少带几条普通词缀（默认 3）。
				}

				BossAffixCountMax: {
					Label: Boss 普通词缀上限
					Tooltip: Boss 最多带几条普通词缀（默认 4）。
				}

				BossExclusiveCountMin: {
					Label: Boss 专属词缀下限
					Tooltip: Boss 至少带几条专属强化词缀（默认 1）。
				}

				BossExclusiveCountMax: {
					Label: Boss 专属词缀上限
					Tooltip: Boss 最多带几条专属强化词缀（默认 2）。
				}

				AffixPowerMult: {
					Label: 词缀数值倍率
					Tooltip: 所有词缀数值的全局倍率（0.25x - 3x，默认 1x）。
				}

				LifeMultCap: {
					Label: 生命乘数上限
					Tooltip: 词缀引起的生命乘数上限（默认 4x），防止词缀+模式+层缩放叠加爆炸。
				}

				DamageMultCap: {
					Label: 伤害乘数上限
					Tooltip: 词缀引起的伤害乘数上限（默认 4x），防止词缀+模式+层缩放叠加爆炸。
				}

				StageScaling: {
					Label: 词缀随阶段上浮
					Tooltip: 词缀数值是否随游戏阶段（0~7）上浮（×(1+0.15×阶段)）。
				}

				ShowAffixInName: {
					Label: 名字显示词缀前缀
					Tooltip: 在敌人名字前加词缀前缀（如「狂暴的骷髅」）。关闭则只染色。
				}

				EliteDropBonusPerAffix: {
					Label: 精英掉落加成（每词缀）
					Tooltip: 精英怪货币掉落 × (1 + 词缀数 × 该值)（默认 0.15，即 3 词缀精英 +45%）。
				}

				ExcludedNpcs: {
					Label: 排除的敌人（显示名）
					Tooltip: 列表中的敌人（按显示名）不附加任何词缀。输入英文/中文显示名均可。
				}

				AffixValueOverrides: {
					Label: 词缀数值覆盖
					Tooltip:
						'''
						逐词缀数值倍率覆盖。key = 词缀英文 Key（如 Strong/Berserk/Thorns），value = 倍率（0 = 默认）。
						例：{"Strong": 3} → 强壮生命加成 ×3；{"Thorns": 0} → 关掉荆棘反伤。适用于生命/伤害/防御/减伤/荆棘/吸血/再生/移速/爆炸/分裂数值。
						'''
				}
			}

			LooteriaConfig: {
				DisplayName: 掠夺之地配置

				Enable: {
					Label: 启用掠夺之地
					Tooltip: 整个打宝系统的总开关。
				}

				AffectModdedItems: {
					Label: 作用于其它模组物品
					Tooltip: 是否对其它模组物品也附加词缀。关闭则只作用于原版物品。
				}

				DropRateMult: {
					Label: 掉落率倍率
					Tooltip: 稀有度权重的全局倍率（0.1x - 5x），作用于魔法及以上稀有度。
				}

				BloodShardRate: {
					Label: 血岩获取倍率
					Tooltip: 击杀/秘境奖励获得血岩的倍率（1x - 10x）。
				}

				DustRate: {
					Label: 重铸之尘获取倍率
					Tooltip: 击杀/秘境奖励/拆解获得重铸之尘的倍率（1x - 10x）。
				}

				MaxStageDropMult: {
					Label: 阶段掉落倍率上限
					Tooltip: 血岩/尘掉落随怪物阶段（0~7）从初始 1x 线性涨到该值（默认 10x）。
				}

				GambleWinChance: {
					Label: 抽奖中奖率
					Tooltip: 血岩抽奖抽中当前档装备的概率（1% - 50%，默认 10%，步进 0.5%）。
				}

				WinSetWeight: {
					Label: 中奖内·套装权重
					Tooltip: 中奖装备中套装占的相对权重（默认 8，总权重 = 四项之和 → 占中奖 8%）。
				}

				WinLegendaryWeight: {
					Label: 中奖内·传说权重
					Tooltip: 中奖装备中传说占的相对权重（默认 16 → 占中奖 16%）。
				}

				WinRareWeight: {
					Label: 中奖内·稀有权重
					Tooltip: 中奖装备中稀有占的相对权重（默认 30 → 占中奖 30%）。
				}

				WinMagicWeight: {
					Label: 中奖内·魔法权重
					Tooltip: 中奖装备中魔法占的相对权重（默认 46 → 占中奖 46%）。
				}

				GambleContainerSize: {
					Label: 掠夺容器格数
					Tooltip: 抽奖存储容器最多容纳的物品数（默认 200）。
				}

				RerollOneDust: {
					Label: 单条重铸费用（重铸之尘）
					Tooltip: 重铸单条词缀消耗的重铸之尘（默认 60；另需装备价值/10 铜币）。
				}

				RerollAllDust: {
					Label: 全部重铸费用（重铸之尘）
					Tooltip: 全部重铸消耗的重铸之尘（默认 20；另需装备价值/20 铜币）。
				}

				UpgradeDust: {
					Label: 稀有度升档费用（重铸之尘）
					Tooltip: 升档消耗的重铸之尘（默认 120；另需装备价值/10 铜币 + 1 件同名装备）。
				}

				UpgradeRarityChance: {
					Label: 升档成功率
					Tooltip: 稀有度升档的成功概率（默认 30%）。
				}

				SalvageDivisor: {
					Label: 拆解尘除数
					Tooltip: 拆解获得的重铸之尘 = 力量等级 ÷ 该值（≥1，默认 2）。
				}

				SocketCostDust: {
					Label: 开槽费用（重铸之尘）
					Tooltip: 开槽消耗的重铸之尘（默认 40；另需装备价值 ÷ 开槽钱币除数 钱币 + 1 件同名装备）。
				}

				RerollOneCoinDiv: {
					Label: 重铸单条钱币除数
					Tooltip: 重铸单条的钱币费用 = 装备价值 ÷ 该值（默认 50；调大更便宜）。
				}

				RerollAllCoinDiv: {
					Label: 全部重铸钱币除数
					Tooltip: 全部重铸的钱币费用 = 装备价值 ÷ 该值（默认 100；调大更便宜）。
				}

				UpgradeCoinDiv: {
					Label: 升档钱币除数
					Tooltip: 稀有度升档的钱币费用 = 装备价值 ÷ 该值（默认 50；调大更便宜）。
				}

				SocketCoinDiv: {
					Label: 开槽钱币除数
					Tooltip: 开槽的钱币费用 = 装备价值 ÷ 该值（默认 100；调大更便宜）。
				}

				GemUpgradeCoinDiv: {
					Label: 宝石升阶钱币除数
					Tooltip: 宝石升阶的钱币费用 = 宝石价值 ÷ 该值（默认 50；调大更便宜）。
				}

				EliteChance: {
					Label: 精英怪概率
					Tooltip: 非 Boss 敌人成为精英怪的概率（默认 8%）。
				}

				RiftCostPerLevel: {
					Label: 秘境每层血岩费用
					Tooltip: 开启第 N 层秘境消耗 = N × 该值（默认 50）。
				}

				RiftDurationMinutes: {
					Label: 秘境时长（分钟）
					Tooltip: 每层秘境的时间限制，分钟（默认 9，霜月时长）。
				}

				TicketDust: {
					Label: 谢谢惠顾券安慰尘
					Tooltip: 使用谢谢惠顾券获得的重铸之尘（默认 5）。
				}

				MaxSockets: {
					Label: 装备插槽上限
					Tooltip: 单件装备最多拥有的插槽总数（默认 6）。
				}

				MaxOpenedSockets: {
					Label: 可手动开启插槽数
					Tooltip: 单件装备最多通过开槽增加的插槽数（默认 4）。
				}

