Mods: {
	Looteria: {
		Configs: {
			EnemyAffixConfig: {
				DisplayName: Enemy Affix Config

				Enable: {
					Label: Enable Enemy Affixes
					Tooltip: Master switch for the enemy affix system. When off, enemies get no affixes.
				}

				CommonAffixChance: {
					Label: Common Affix Chance
					Tooltip: Chance for a normal non-boss enemy to carry 1 common affix (0-50%, default 20%).
				}

				EliteChance: {
					Label: Elite Chance
					Tooltip: Chance for a non-boss enemy to become an elite (0-50%, default 8%). Elites carry 2-3 affixes, stronger effects, better drops.
				}

				EliteAffixCountMin: {
					Label: Elite Affix Count Min
					Tooltip: Minimum affixes an elite carries (default 2).
				}

				EliteAffixCountMax: {
					Label: Elite Affix Count Max
					Tooltip: Maximum affixes an elite carries (default 3).
				}

				BossAffixCountMin: {
					Label: Boss Affix Count Min
					Tooltip: Minimum common affixes a boss carries (default 3).
				}

				BossAffixCountMax: {
					Label: Boss Affix Count Max
					Tooltip: Maximum common affixes a boss carries (default 4).
				}

				BossExclusiveCountMin: {
					Label: Boss Exclusive Affix Count Min
					Tooltip: Minimum exclusive affixes a boss carries (default 1).
				}

				BossExclusiveCountMax: {
					Label: Boss Exclusive Affix Count Max
					Tooltip: Maximum exclusive affixes a boss carries (default 2).
				}

				AffixPowerMult: {
					Label: Affix Power Mult
					Tooltip: Global multiplier for all affix values (0.25x - 3x, default 1x).
				}

				LifeMultCap: {
					Label: Life Mult Cap
					Tooltip: Cap on the life multiplier from affixes (default 4x), prevents blow-up when stacked with mode + rift scaling.
				}

				DamageMultCap: {
					Label: Damage Mult Cap
					Tooltip: Cap on the damage multiplier from affixes (default 4x), prevents blow-up when stacked with mode + rift scaling.
				}

				StageScaling: {
					Label: Stage Scaling
					Tooltip: Whether affix values scale with game stage (0-7) as ×(1+0.15×stage).
				}

				ShowAffixInName: {
					Label: Show Affix Prefix In Name
					Tooltip: Prepend the affix name to the enemy name (e.g. "Berserk Zombie"). Off = color tint only.
				}

				EliteDropBonusPerAffix: {
					Label: Elite Drop Bonus Per Affix
					Tooltip: Elite currency drops × (1 + affix count × this value) (default 0.15, so a 3-affix elite drops +45%).
				}

				ExcludedNpcs: {
					Label: Excluded Enemies (Display Name)
					Tooltip: Enemies in this list (by display name) never get affixes. English or Chinese names both work.
				}

				AffixValueOverrides: {
					Label: Affix Value Overrides
					Tooltip:
						'''
						Per-affix numeric multiplier overrides. key = affix English Key (e.g. Strong/Berserk/Thorns), value = multiplier (0 = default).
						Example: {"Strong": 3} → Strong life bonus ×3; {"Thorns": 0} → disable thorns reflect. Applies to life/damage/defense/DR/thorns/lifesteal/regen/speed/explosion/split values.
						'''
				}
			}

			LooteriaConfig: {
				DisplayName: Looteria Config

				Enable: {
					Label: Enable
					Tooltip: ""
				}

				AffectModdedItems: {
					Label: Affect Modded Items
					Tooltip: ""
				}

				DropRateMult: {
					Label: Drop Rate Mult
					Tooltip: Global rarity weight multiplier (0.1x - 5x), applies to Magic and above.
				}

				BloodShardRate: {
					Label: Blood Shard Rate
					Tooltip: Blood Shard gain multiplier from kills / Rift rewards (1x - 10x).
				}

				DustRate: {
					Label: Reforge Dust Rate
					Tooltip: Reforge Dust gain multiplier from kills / Rift rewards / salvage (1x - 10x).
				}

				MaxStageDropMult: {
					Label: Max Stage Drop Mult
					Tooltip: Blood Shard / Reforge Dust drops scale with monster stage (0-7) linearly from 1x to this value (default 10x).
				}

				GambleWinChance: {
					Label: Draw Win Chance
					Tooltip: Chance to hit the current tier's gear when drawing (1% - 50%, default 10%, step 0.5%).
				}

				WinSetWeight: {
					Label: Win: Set Weight
					Tooltip: Relative weight of Set gear among winning draws (default 8; total = sum of all four → 8% of wins).
				}

				WinLegendaryWeight: {
					Label: Win: Legendary Weight
					Tooltip: Relative weight of Legendary gear among winning draws (default 16 → 16% of wins).
				}

				WinRareWeight: {
					Label: Win: Rare Weight
					Tooltip: Relative weight of Rare gear among winning draws (default 30 → 30% of wins).
				}

				WinMagicWeight: {
					Label: Win: Magic Weight
					Tooltip: Relative weight of Magic gear among winning draws (default 46 → 46% of wins).
				}

				GambleContainerSize: {
					Label: Draw Container Size
					Tooltip: Max items the draw container can hold (default 200).
				}

				RerollOneDust: {
					Label: Reroll One Cost (Dust)
					Tooltip: Reforge Dust cost to reroll a single affix (default 60; plus item value / 10 coins).
				}

				RerollAllDust: {
					Label: Reroll All Cost (Dust)
					Tooltip: Reforge Dust cost to reroll all affixes (default 20; plus item value / 20 coins).
				}

				UpgradeDust: {
					Label: Rarity Upgrade Cost (Dust)
					Tooltip: Reforge Dust cost to upgrade rarity (default 120; plus item value / 10 coins and 1 same-name item).
				}

				UpgradeRarityChance: {
					Label: Upgrade Success Chance
					Tooltip: Chance for a rarity upgrade to succeed (default 30%).
				}

				SalvageDivisor: {
					Label: Salvage Dust Divisor
					Tooltip: Salvaged Reforge Dust = Power Score / this value (>= 1, default 2).
				}

				SocketCostDust: {
					Label: Socket Cost (Reforge Dust)
					Tooltip: Cost in Reforge Dust to open a socket (default 40; plus item value / socket coin divisor + 1 same-name item).
				}

				RerollOneCoinDiv: {
					Label: Reroll One Coin Divisor
					Tooltip: Coin cost of rerolling one affix = item value / this value (default 50; larger = cheaper).
				}

				RerollAllCoinDiv: {
					Label: Reroll All Coin Divisor
					Tooltip: Coin cost of rerolling all affixes = item value / this value (default 100; larger = cheaper).
				}

				UpgradeCoinDiv: {
					Label: Upgrade Coin Divisor
					Tooltip: Coin cost of rarity upgrade = item value / this value (default 50; larger = cheaper).
				}

				SocketCoinDiv: {
					Label: Socket Coin Divisor
					Tooltip: Coin cost of opening a socket = item value / this value (default 100; larger = cheaper).
				}

				GemUpgradeCoinDiv: {
					Label: Gem Upgrade Coin Divisor
					Tooltip: Coin cost of gem enhancement = gem value / this value (default 50; larger = cheaper).
				}

				EliteChance: {
					Label: Elite Chance
					Tooltip: Chance for a non-boss enemy to become an Elite (default 8%).
				}

				RiftCostPerLevel: {
					Label: Rift Cost per Level (Shards)
					Tooltip: Starting Rift level N costs N x this in Blood Shards (default 50).
				}

				RiftDurationMinutes: {
					Label: Rift Duration (minutes)
					Tooltip: Time limit per Rift level in minutes (default 9, Frost Moon length).
				}

				TicketDust: {
					Label: Consolation Ticket Dust
					Tooltip: Reforge Dust gained from using a Thank-You Ticket (default 5).
				}

				MaxSockets: {
					Label: Max Sockets
					Tooltip: Maximum total sockets a single item can have (default 6).
				}

				MaxOpenedSockets: {
					Label: Max Manually Opened Sockets
					Tooltip: Maximum sockets a single item can gain from socket-opening (default 4).
				}

				AffixMaxAllDamage: {
					Label: Affix Cap: All Damage
					Tooltip: Affix value cap (built-in default 100).
				}

				AffixMaxMeleeDamage: {
					Label: Affix Cap: Melee Damage
					Tooltip: Affix value cap (built-in default 150).
				}

				AffixMaxRangedDamage: {
					Label: Affix Cap: Ranged Damage
					Tooltip: Affix value cap (built-in default 150).
				}

				AffixMaxMagicDamage: {
					Label: Affix Cap: Magic Damage
					Tooltip: Affix value cap (built-in default 150).
				}

				AffixMaxSummonDamage: {
					Label: Affix Cap: Summon Damage
					Tooltip: Affix value cap (built-in default 150).
				}

				AffixMaxCritChance: {
					Label: Affix Cap: Crit Chance
					Tooltip: Affix value cap (built-in default 30).
				}

				AffixMaxCritDamage: {
					Label: Affix Cap: Crit Damage
					Tooltip: Affix value cap (built-in default 100).
				}

				AffixMaxAttackSpeed: {
					Label: Affix Cap: Attack Speed
					Tooltip: Affix value cap (built-in default 60).
				}

				AffixMaxFlatDamage: {
					Label: Affix Cap: Flat Damage
					Tooltip: Affix value cap (built-in default 60).
				}

				AffixMaxLifeOnHit: {
					Label: Affix Cap: Life on Hit
					Tooltip: Affix value cap (built-in default 3; flat heal, not % of damage).
				}

				AffixMaxManaOnHit: {
					Label: Affix Cap: Mana on Hit
					Tooltip: Affix value cap (built-in default 2).
				}

				AffixMaxManaCost: {
					Label: Affix Cap: Mana Cost
					Tooltip: Affix value cap (built-in default 50).
				}

				AffixMaxKnockback: {
					Label: Affix Cap: Knockback
					Tooltip: Affix value cap (built-in default 150).
				}

				AffixMaxDefense: {
					Label: Affix Cap: Defense
					Tooltip: Affix value cap (built-in default 12).
				}

				AffixMaxDamageReduction: {
					Label: Affix Cap: Damage Reduction
					Tooltip: Affix value cap (built-in default 5).
				}

				AffixMaxMaxLife: {
					Label: Affix Cap: Max Life
					Tooltip: Affix value cap (built-in default 200).
				}

				AffixMaxLifeRegen: {
					Label: Affix Cap: Life Regen
					Tooltip: Affix value cap (built-in default 6).
				}

				AffixMaxManaRegen: {
					Label: Affix Cap: Mana Regen
					Tooltip: Affix value cap (built-in default 10).
				}

				AffixMaxMoveSpeed: {
					Label: Affix Cap: Move Speed
					Tooltip: Affix value cap (built-in default 40).
				}

				AffixMaxBuffResistPoison: {
					Label: Affix Cap: Poison Resist
					Tooltip: Affix value cap (built-in default 100).
				}

				AffixMaxBuffResistFire: {
					Label: Affix Cap: Fire Resist
					Tooltip: Affix value cap (built-in default 100).
				}

				AffixMaxBuffResistBleed: {
					Label: Affix Cap: Bleed Resist
					Tooltip: Affix value cap (built-in default 100).
				}

				AffixMaxBuffResistCurse: {
					Label: Affix Cap: Curse Resist
					Tooltip: Affix value cap (built-in default 100).
				}

				AffixMaxBuffResistSlow: {
					Label: Affix Cap: Slow Resist
					Tooltip: Affix value cap (built-in default 100).
				}

				AffixMaxMiningSpeed: {
					Label: Affix Cap: Mining Speed
					Tooltip: Affix value cap (built-in default 80).
				}

				AffixMaxFishingPower: {
					Label: Affix Cap: Fishing Power
					Tooltip: Affix value cap (built-in default 40).
				}

				AffixMaxFlatArmorShred: {
					Label: Affix Cap: Armor Shred (Flat)
					Tooltip: Affix value cap (built-in default 5; flat defense shred applied after the percentage).
				}

				AffixMaxPctArmorShred: {
					Label: Affix Cap: Armor Shred (Pct)
					Tooltip: Affix value cap (built-in default 5; percentage defense shred applied first).
				}

				AffectWeapons: {
					Label: Affect Weapons
					Tooltip: ""
				}

				AffectArmor: {
					Label: Affect Armor
					Tooltip: ""
				}

				AffectAccessories: {
					Label: Affect Accessories
					Tooltip: ""
				}

				AffectTools: {
					Label: Affect Tools
					Tooltip: ""
